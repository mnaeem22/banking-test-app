# Copy this file to ".env" and adjust the values for your MySQL server.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=DemoBankingDB

PORT=3000

# true  = the API contains the intentional defects (default, used for student exercises)
# false = the API behaves correctly (reference behaviour for the teacher)
# Can also be switched while the app is running, from the header of the web page.
ENABLE_BUGS=true
