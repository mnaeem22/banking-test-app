        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zoya Ali\",\n  \"email\": \"zoya.ali@example.com\",\n  \"city\": \"Karachi\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Response has customerId\", () => pm.expect(j.customerId).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"customerId\", j.customerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer by id",
